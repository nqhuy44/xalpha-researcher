# =============================================================================
# xalpha-researcher — Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM Abstraction Layer (Multi-Provider)
# -----------------------------------------------------------------------------
LLM__PROVIDER=gemini  # gemini, openai, ollama, grok, deepseek, claude
LLM__FAST_MODEL_ROLE=fast
LLM__DEEP_MODEL_ROLE=deep
LLM__ALLOW_FALLBACK=true

# Agent-Specific Overrides (Optional)
# LLM__AGENT_PROVIDERS__BULL=gemini
# LLM__AGENT_PROVIDERS__BEAR=ollama
# LLM__AGENT_PROVIDERS__JUDGE=openai
# LLM__AGENT_PROVIDERS__REFEREE=claude

# Google Gemini
GEMINI__API_KEY=
GEMINI__MODEL_PRO=gemini-1.5-pro
GEMINI__MODEL_FLASH=gemini-1.5-flash
GEMINI__MODEL_LITE=gemini-1.5-flash-lite

# OpenAI (Alternative)
OPENAI__API_KEY=
OPENAI__MODEL_DEEP=gpt-4o
OPENAI__MODEL_FAST=gpt-4o-mini

# Ollama / Local vLLM (OpenAI-compatible)
OLLAMA__BASE_URL=http://localhost:11434/v1
OLLAMA__MODEL_DEEP=qwen2.5:7b
OLLAMA__MODEL_FAST=qwen2.5:7b
OLLAMA__NUM_CTX=32768
OLLAMA__TEMPERATURE=0.2

# xAI Grok
GROK__API_KEY=
GROK__MODEL_DEEP=grok-2-1212
GROK__MODEL_FAST=grok-2-1212

# DeepSeek
DEEPSEEK__API_KEY=
DEEPSEEK__MODEL_DEEP=deepseek-reasoner
DEEPSEEK__MODEL_FAST=deepseek-chat

# Anthropic Claude
CLAUDE__API_KEY=
CLAUDE__MODEL_DEEP=claude-3-7-sonnet-latest
CLAUDE__MODEL_FAST=claude-3-5-haiku-latest

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__DB=xalpha
POSTGRES__USER=xalpha
POSTGRES__PASSWORD=
POSTGRES__POOL_SIZE=5

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
TELEGRAM__TOKEN=
TELEGRAM__CHAT_ID=
TELEGRAM__ENABLED=true

# -----------------------------------------------------------------------------
# Data Sources / Financial APIs
# -----------------------------------------------------------------------------
# Configures the hours (0-23) the News Scheduler operates. E.g [7, 19]
NEWS__SCHEDULE_HOURS=[7, 19]

VNSTOCK_SOURCE=TCBS
VNSTOCK__API_KEY=
VNSTOCK__REQ_DELAY=2.0
# SSI_API_KEY=
# TCBS_API_KEY=

# -----------------------------------------------------------------------------
# S3-compatible Object Storage
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=xalpha-reports

# -----------------------------------------------------------------------------
# JWT Authentication (Dashboard)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
